# Alamat server multiplayer/obrolan (WebSocket). Isi saat build di Vercel (Environment Variables).
# Contoh: wss://orbit-server.up.railway.app
VITE_SERVER_URL=

# Penghubung undangan -> dunia (opsional). Anon key aman di browser; akses dibatasi RLS di Supabase.
# Dipakai untuk menampilkan judul acara dan memverifikasi bahwa ?e=<slug> adalah undangan yang aktif.
# Studio Dunia (editor.html) memakai dua variabel yang sama untuk akun dan penyimpanan versi dunia (hanya anon key, jangan service key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Untuk fungsi /api/token (server): boleh memakai nama yang sama dengan di atas.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Draf dunia dengan AI (fungsi /api/ai-world, hanya di server; JANGAN diberi awalan VITE_).
# Tanpa ANTHROPIC_API_KEY fitur mati (tombol AI menampilkan "tidak aktif"). Hanya pengguna yang sudah masuk (sesi Supabase) yang bisa memakainya.
# ANTHROPIC_API_KEY=
# AI_WORLD_MODEL=claude-haiku-5-5
# AI_WORLD_PER_HOUR=5
# AI_WORLD_DAILY_CAP=100
# AI_WORLD_DISABLED=1
